<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="usagebeam">
  <schema id="org.gnome.shell.extensions.usagebeam"
          path="/org/gnome/shell/extensions/usagebeam/">
    <key name="refresh-interval" type="i">
      <default>120</default>
      <range min="30" max="3600"/>
      <summary>Refresh interval</summary>
      <description>How often to refresh usage data, in seconds (30–3600)</description>
    </key>
    <key name="notifications-enabled" type="b">
      <default>true</default>
      <summary>Enable notifications</summary>
      <description>Show one desktop notification when usage crosses each configured warning milestone</description>
    </key>
    <key name="enabled-providers" type="as">
      <default>['codex', 'claude']</default>
      <summary>Enabled providers</summary>
    </key>
    <key name="provider-order" type="as">
      <default>['codex', 'claude', 'opencode']</default>
      <summary>Provider display order</summary>
    </key>
    <key name="default-provider" type="s">
      <default>'codex'</default>
      <summary>Selected usage provider</summary>
    </key>
    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="right"/>
        <choice value="left-of-calendar"/>
        <choice value="right-of-calendar"/>
      </choices>
      <default>'right-of-calendar'</default>
      <summary>Panel position</summary>
      <description>Place UsageBeam in the left or right panel area, or immediately beside the calendar</description>
    </key>
    <key name="history-retention-days" type="i">
      <default>30</default>
      <range min="7" max="90"/>
      <summary>Days of usage metadata to retain</summary>
    </key>
    <key name="notification-threshold" type="i">
      <default>90</default>
      <range min="50" max="100"/>
      <summary>First usage percentage that triggers a warning</summary>
    </key>
    <key name="clear-data-generation" type="u">
      <default>0</default>
      <summary>Saved usage reset counter</summary>
      <description>Changing this value discards current UsageBeam snapshots before rebuilding them from provider sources</description>
    </key>
  </schema>
  <!-- Provider capabilities are discovered at runtime; unsupported fields are never invented. -->
</schemalist>
